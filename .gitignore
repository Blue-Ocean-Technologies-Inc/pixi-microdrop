# IDE
.idea/

# Claude Code: shared config is tracked, per-machine permission grants are not
.claude/settings.local.json
**/.claude/settings.local.json

# The standalone plugin repos live here as their own git repos
heater-microdrop-plugin-py/
magnet-microdrop-plugin-py/
fluorescence-microdrop-plugin-py/

# Python bytecode
__pycache__/
*.py[cod]

# Firmware images are distributed with the boards, never through this repo
firmware_*.zip
*.hex
*.uf2

# Scratch
.superpowers/
scratch/
demo/
microdrop-py/demo/

# Built by CI (release-setup-exe workflow) — download from GitHub Releases
microdrop_setup.exe

# `pixi run pack-prod` output: built wheels and the packed prod environment
microdrop-py/dist/

# Hand-off folders/zips for sending a packed Windows install to a user
share-microdrop*/
share-microdrop*.zip
